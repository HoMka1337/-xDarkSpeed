@page
@model SS14.Admin.Pages.Sponsors.IndexModel
@using SS14.Admin
@{ ViewData["Title"] = "Спонсоры и донаты"; var now = DateTimeOffset.UtcNow; }
<div class="gs-page-heading"><div><span class="gs-eyebrow">GRIBLE STATION</span><h1>Спонсоры и донаты</h1><p class="gs-muted">Заявки, ручное подтверждение оплаты, подписки и состав уровней.</p></div><a class="btn btn-primary" asp-page="/Donate/Index" target="_blank" rel="noopener">Открыть сайт донатов ↗</a></div>
@if (Model.Notice != null) { <div class="alert alert-info" role="status">@Model.Notice</div> }
@if (Model.Error != null) { <div class="alert alert-danger">@Model.Error</div> }
<div class="alert alert-secondary">Перед подтверждением проверь фактическое поступление оплаты и идентификатор аккаунта. Подтверждение выдаёт привилегии; создание заявки их не выдаёт.</div>
<p class="gs-muted">Идентификатор аккаунта (UUID) — уникальный код игрока. Время в таблицах указано по всемирному времени (UTC).</p>
<h2>Ожидают проверки (@Model.State.Orders.Count(o => o.Status == "pending"))</h2><div class="table-responsive"><table class="table"><thead><tr><th>Заявка / время UTC</th><th>Аккаунт</th><th>Уровень / сумма</th><th>Действия</th></tr></thead><tbody>
@foreach (var order in Model.State.Orders.Where(o => o.Status == "pending").OrderBy(o => o.CreatedAt))
{
    <tr><td><code>@order.Id</code><br />@order.CreatedAt.UtcDateTime.ToString("dd.MM.yyyy HH:mm")</td><td>@order.PlayerName<br /><code>@order.UserId</code></td><td>@order.Tier.Name · @LustSponsorStore.Count(order.Tier.Days, "день", "дня", "дней")<br /><strong>@order.Amount.ToString("0.##") @LustSponsorStore.Symbol(order.Currency)</strong></td><td><form method="post" asp-page-handler="Confirm" class="mb-2"><input type="hidden" name="orderId" value="@order.Id" /><button class="btn btn-success" type="submit">Оплата проверена — активировать</button></form><form method="post" asp-page-handler="Decline" class="d-flex gap-2"><input type="hidden" name="orderId" value="@order.Id" /><input name="message" maxlength="300" class="form-control" aria-label="Причина отклонения" placeholder="Сообщение игроку" /><button class="btn btn-outline-danger" type="submit">Отклонить</button></form></td></tr>
}
</tbody></table></div>
<h2>Выдать или продлить вручную</h2><form method="post" asp-page-handler="Grant" class="card card-body mb-4"><div class="row g-3"><div class="col-md-6"><label for="sponsor-user" class="form-label">Идентификатор игрового аккаунта</label><input id="sponsor-user" name="userId" required list="sponsor-players" class="form-control" placeholder="Выбери идентификатор игрока" /><datalist id="sponsor-players">@foreach (var player in Model.Players) { <option value="@player.Key">@player.Value</option> }</datalist></div><div class="col-md-4"><label for="sponsor-tier" class="form-label">Уровень</label><select id="sponsor-tier" name="tierKey" class="form-select">@foreach (var tier in Model.State.Tiers) { <option value="@tier.Key">@tier.Name · @LustSponsorStore.Count(tier.Days, "день", "дня", "дней")</option> }</select></div><div class="col-md-4"><label for="grant-period" class="form-label">Срок</label><select id="grant-period" name="period" class="form-select">@foreach (var period in LustSponsorStore.Periods) { <option value="@period">@LustSponsorStore.PeriodName(period)</option> }</select></div><div class="col-md-2 d-flex align-items-end"><button class="btn btn-primary" type="submit">Выдать</button></div></div></form>
<h2>Действующие и будущие подписки</h2><div class="table-responsive"><table class="table"><thead><tr><th>Игрок</th><th>Уровень</th><th>Начало UTC</th><th>Окончание UTC</th><th>Состояние</th><th></th></tr></thead><tbody>
@foreach (var member in Model.State.Memberships.Where(m => m.RevokedAt == null && m.ExpiresAt > now).OrderBy(m => m.ExpiresAt))
{
    <tr><td>@Model.PlayerName(member.UserId)<br /><code>@member.UserId</code></td><td>@member.Tier.Name</td><td>@member.StartsAt.UtcDateTime.ToString("dd.MM.yyyy HH:mm")</td><td>@member.ExpiresAt.UtcDateTime.ToString("dd.MM.yyyy HH:mm")</td><td>@(member.StartsAt > now ? "Продление ожидает начала" : "Действует")</td><td><form method="post" asp-page-handler="Revoke"><input type="hidden" name="membershipId" value="@member.Id" /><button class="btn btn-outline-danger btn-sm" type="submit">Отозвать</button></form></td></tr>
}
</tbody></table></div>
<h2>Инструкция по оплате</h2><form method="post" asp-page-handler="Instructions" class="card card-body mb-4"><label for="payment-instructions" class="form-label">Текст на личной странице заявки: способ оплаты, реквизиты или контакт для согласования</label><textarea id="payment-instructions" name="instructions" rows="4" maxlength="2000" class="form-control mb-3">@Model.State.PaymentInstructions</textarea><button class="btn btn-primary align-self-start" type="submit">Сохранить инструкцию</button></form>
<h2>Уровни и цены</h2><p class="gs-muted">Цены указаны за месяц. Скидки: три месяца — 20%, год — 30%. Для каждой валюты задаётся своя цена. Изменения действуют для новых заявок; состав оформленных подписок сохраняется.</p>
@foreach (var tier in Model.State.Tiers.OrderBy(t => t.Rank))
{
    <details class="card mb-3"><summary class="card-header">@tier.Name · @tier.GhostThemes.Length обликов · @tier.Pets.Length питомцев · +@tier.ExtraSlots мест для персонажей</summary><form method="post" asp-page-handler="Tier" class="card-body"><input type="hidden" name="key" value="@tier.Key" /><div class="row g-3"><div class="col-md-5"><label for="name-@tier.Key" class="form-label">Название</label><input id="name-@tier.Key" name="name" value="@tier.Name" maxlength="40" required class="form-control" /></div><div class="col-md-3"><label for="days-@tier.Key" class="form-label">Базовый срок, дней</label><input id="days-@tier.Key" name="days" value="@tier.Days" type="number" min="1" max="365" required class="form-control" /></div><div class="col-md-4"><label for="color-@tier.Key" class="form-label">Цвет внеигрового чата</label><input id="color-@tier.Key" name="oocColor" value="@tier.OocColor" type="color" class="form-control form-control-color" /></div>@foreach (var currency in LustSponsorStore.Currencies) { <div class="col-md-4"><label for="price-@currency-@tier.Key" class="form-label">Цена: @LustSponsorStore.CurrencyName(currency)</label><input id="price-@currency-@tier.Key" name="@currency.ToLowerInvariant()" value="@tier.Prices.GetValueOrDefault(currency).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" type="number" step="0.01" min="0.01" max="100000" required class="form-control" /></div> }<div class="col-md-6"><label for="slots-@tier.Key" class="form-label">Дополнительные места для персонажей</label><input id="slots-@tier.Key" name="extraSlots" value="@tier.ExtraSlots" type="number" min="0" max="20" class="form-control" /></div><div class="col-md-6"><label for="flavor-@tier.Key" class="form-label">Лимит описания персонажа</label><input id="flavor-@tier.Key" name="flavorLength" value="@tier.FlavorLength" type="number" min="512" max="20000" class="form-control" /></div><div class="col-lg-6"><label for="ghosts-@tier.Key" class="form-label">Облики призрака (удерживай Ctrl для выбора нескольких)</label><select id="ghosts-@tier.Key" name="ghostThemes" multiple size="9" class="form-select">@foreach (var item in Model.Items.Where(i => i.Kind == "ghost" && i.Restricted)) { <option value="@item.PrototypeId" selected="@tier.GhostThemes.Contains(item.PrototypeId)">@item.Name</option> }</select></div><div class="col-lg-6"><label for="pets-@tier.Key" class="form-label">Питомцы (удерживай Ctrl для выбора нескольких)</label><select id="pets-@tier.Key" name="pets" multiple size="9" class="form-select">@foreach (var item in Model.Items.Where(i => i.Kind == "pet" && i.Restricted)) { <option value="@item.PrototypeId" selected="@tier.Pets.Contains(item.PrototypeId)">@item.Name</option> }</select></div></div><button class="btn btn-primary mt-3" type="submit">Сохранить @tier.Name</button></form></details>
}
<h2>Последние действия</h2><div class="table-responsive"><table class="table"><thead><tr><th>Время UTC</th><th>Действие</th><th>Аккаунт</th><th>Подробности</th><th>Администратор</th></tr></thead><tbody>@foreach (var entry in Model.State.History.AsEnumerable().Reverse().Take(50)) { <tr><td>@entry.At.UtcDateTime.ToString("dd.MM.yyyy HH:mm")</td><td>@(entry.Action switch { "confirm" => "Подтверждение оплаты", "grant" => "Ручная выдача", "revoke" => "Отзыв", "decline" => "Отклонение", "edit-tier" => "Изменение уровня", "catalog" => "Обновление уровней", _ => "Инструкция оплаты" })</td><td>@(entry.UserId is { } id ? Model.PlayerName(id) : "—")</td><td>@entry.Details</td><td>@Model.PlayerName(entry.Actor)</td></tr> }</tbody></table></div>
