@page "{ban}"
@using SS14.Admin.Helpers
@using SS14.Admin.Pages.Tables
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model SS14.Admin.Pages.Bans.Hits

@{
    ViewData["Title"] = "Срабатывания блокировки";
}

<div class="container">
    <h1>Срабатывания блокировки № @Model.Ban.Ban.Id</h1>

    <dl class="row">
        <dt class="col-sm-2">Имя:</dt>
        <dd class="col-sm-10">@(string.Join(", ", Model.Ban.Players.Select(p => p.LastSeenUserName)))</dd>
        <dt class="col-sm-2">Код аккаунта:</dt>
        <dd class="col-sm-10 font-monospace">@(string.Join(", ", Model.Ban.Ban.Id))</dd>
        @if (User.IsInRole(Constants.PIIRole))
        {
            <dt class="col-sm-2">IP:</dt>
            <dd class="col-sm-10 font-monospace">@(string.Join(", ", Model.Ban.Ban.Addresses!.Select(ba => ba.Address.FormatCidr())))</dd>
            <dt class="col-sm-2">Код устройства:</dt>
            <dd class="col-sm-10 font-monospace">@(string.Join(", ", Model.Ban.Ban.Hwids!.Select(ba => ba.HWId.ToImmutable().ToString())))</dd>
        }
        <dt class="col-sm-2">Время:</dt>
        <dd class="col-sm-10">@Model.Ban.Ban.BanTime.ToString("yyyy-MM-dd HH:mm:ss")</dd>
        <dt class="col-sm-2">Окончание:</dt>
        <dd class="col-sm-10">
            @(Model.Ban.Ban.ExpirationTime?.ToString("yyyy-MM-dd HH:mm:ss") ?? "БЕССРОЧНО")
            @if (Model.Ban.Ban.Unban is { } unbanned)
            {
                <br>
                <text><strong>Блокировка снята:</strong> @unbanned.UnbanTime.ToString("yyyy-MM-dd HH:mm:ss") — администратор: @Model.Ban.UnbanAdmin?.LastSeenUserName</text>
            }
            else if (Model.Ban.Ban.ExpirationTime < DateTime.UtcNow)
            {
                <br>
                <strong>Срок истёк</strong>
            }
        </dd>
        <dt class="col-sm-2">Заблокировал:</dt>
        <dd class="col-sm-10">@Model.Ban.Admin?.LastSeenUserName</dd>
        @if (BanHelper.IsBanActive(Model.Ban.Ban) && User.IsInRole("BAN"))
        {
            <dt class="col-sm-2">Действия:</dt>
            <dd class="col-sm-10">
                <form asp-page-handler="Unban" asp-page="Index">
                    <input type="hidden" name="Id" value="@Model.Ban.Ban.Id">
                    <input type="submit" class="btn btn-secondary" value="Снять блокировку">
                </form>
            </dd>
        }
    </dl>
</div>


<form asp-all-route-data="@Model.AllRouteData.ShallowClone()" method="get" class="container">
    @FormHiddenRoutes.Make(Model.AllRouteData, "search")
    <div class="form-group row">
        <label class="col-md-3" for="searchBar">Поиск:</label>
        <input type="text" id="searchBar" name="search" value="@Model.CurrentFilter" class="form-control form-control-sm col-md-7"/>
        <input type="submit" value="Найти" class="btn btn-primary col-md-1 btn-sm"/>
        <a class="btn btn-danger btn-sm col-md-1" asp-page="./Index">Сбросить</a>
    </div>
</form>

<partial name="Tables/ConnectionsTable" model="@(new ConnectionsTableModel(Model.SortState, Model.Pagination))"/>
