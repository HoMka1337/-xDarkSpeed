@page "{id:guid}"
@model SS14.Admin.Pages.Donate.OrderModel
@using SS14.Admin
@{ Layout = "_DonationLayout"; ViewData["Title"] = "Твоя заявка"; var order = Model.Order; }
<section class="support-order support-width"><a class="support-back" asp-page="./Index">← На витрину</a><span class="support-eyebrow">GRIBLE STATION · ЛИЧНАЯ ЗАЯВКА</span><h1>@(order.Status == "confirmed" ? "Спасибо за поддержку!" : order.Status == "declined" ? "Заявка закрыта." : "Заявка создана.")</h1><div class="support-alert @(order.Status == "confirmed" ? "success" : "")">@(order.Status == "confirmed" ? "Оплата подтверждена. Переподключись к серверу, чтобы получить привилегии." : order.Status == "declined" ? "Администратор отклонил заявку. При необходимости создай новую." : "Ожидает проверки оплаты администратором. Сохрани эту ссылку и обнови страницу после подтверждения.")</div><div class="support-order-grid"><article class="support-form"><h2>Детали заявки</h2><dl><dt>Номер</dt><dd><code>@order.Id</code></dd><dt>Уровень</dt><dd>@order.Tier.Name · @LustSponsorStore.Count(order.Tier.Days, "день", "дня", "дней")</dd><dt>Срок</dt><dd>@LustSponsorStore.PeriodName(order.Period)@if (order.Discount > 0) { <text> · скидка @order.Discount%</text> }</dd><dt>Сумма за весь срок</dt><dd>@order.Amount.ToString("0.##") @LustSponsorStore.Symbol(order.Currency)</dd><dt>Игровой аккаунт</dt><dd>@order.PlayerName<br /><code>@order.UserId</code></dd><dt>Статус</dt><dd>@(order.Status == "confirmed" ? "Подтверждено" : order.Status == "declined" ? "Отклонено" : "Ожидает подтверждения")</dd></dl>@if (!string.IsNullOrWhiteSpace(order.Message)) { <div class="support-alert">@order.Message</div> }<button type="button" class="support-button secondary" onclick="location.reload()">Обновить статус ↻</button></article><article class="support-form"><h2>@(order.Status == "confirmed" ? "Что дальше" : "Инструкция по оплате")</h2>@if (order.Status == "confirmed") { <p>Переподключись к игре. Облик выбирается действием призрака, питомец — в лобби. Дополнительные места для персонажей доступны в настройке персонажей.</p><p>При продлении того же уровня новый срок начнётся после окончания действующей подписки.</p> } else { <p class="support-instructions">@Model.Instructions</p><p>Укажи номер заявки при оплате, чтобы администратор нашёл нужный аккаунт.</p> }<small class="support-muted">Личная ссылка открывает сведения этой заявки. Сохрани её у себя.</small></article></div></section>
